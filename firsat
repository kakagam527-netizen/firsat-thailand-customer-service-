@app.route("/orders/add", methods=["GET", "POST"])
def add_order():

    conn = get_db()

    customers = conn.execute("""
        SELECT *
        FROM customers
        ORDER BY name
    """).fetchall()

    if request.method == "POST":

        last = conn.execute("""
            SELECT order_code
            FROM orders
            ORDER BY id DESC
            LIMIT 1
        """).fetchone()

        if last:
            number = int(last["order_code"].replace("ORD", "")) + 1
        else:
            number = 1

        order_code = f"ORD{number:05d}"

        quantity = int(request.form["quantity"])
        unit_cost = float(request.form["unit_cost"])
        unit_sale = float(request.form["unit_sale"])
        shipping = float(request.form["shipping"])
        paid = float(request.form["paid"])

        total = quantity * unit_sale + shipping
        cost = quantity * unit_cost + shipping
        profit = total - cost

        remaining = total - paid

        if remaining <= 0:
            payment_status = "Paid"
        elif paid > 0:
            payment_status = "Partial"
        else:
            payment_status = "Unpaid"

        conn.execute("""
            INSERT INTO orders
            (
                order_code,
                customer_code,
                order_date,
                source,
                status,
                payment_status,
                payment_method,
                supplier,
                total,
                cost,
                shipping,
                paid,
                profit
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            order_code,
            request.form["customer_code"],
            request.form["order_date"],
            request.form["source"],
            request.form["status"],
            payment_status,
            request.form["payment_method"],
            request.form["supplier"],
            total,
            cost,
            shipping,
            paid,
            profit
        ))

        conn.execute("""
            INSERT INTO order_items
            (
                order_code,
                product,
                sku,
                quantity,
                unit_cost,
                unit_sale
            )
            VALUES (?, ?, ?, ?, ?, ?)
        """, (
            order_code,
            request.form["product"],
            request.form["sku"],
            quantity,
            unit_cost,
            unit_sale
        ))

        conn.commit()
        conn.close()

        return redirect(url_for("orders_page"))

    conn.close()

    return render_template(
        "add_order.html",
        customers=customers
    )


@app.route("/customer/<code>")
def customer_details(code):

    conn = get_db()

    customer = conn.execute("""
        SELECT *
        FROM customers
        WHERE code = ?
    """, (code,)).fetchone()

    orders = conn.execute("""
        SELECT *
        FROM orders
        WHERE customer_code = ?
        ORDER BY id DESC
    """, (code,)).fetchall()

    conn.close()

    if not customer:
        return "Customer not found", 404

    return render_template(
        "customer_details.html",
        customer=customer,
        orders=orders
    )


@app.route("/order/<order_code>")
def order_details(order_code):

    conn = get_db()

    order = conn.execute("""
        SELECT *
        FROM orders
        WHERE order_code = ?
    """, (order_code,)).fetchone()

    items = conn.execute("""
        SELECT *
        FROM order_items
        WHERE order_code = ?
    """, (order_code,)).fetchall()

    conn.close()

    if not order:
        return "Order not found", 404

    return render_template(
        "order_details.html",
        order=order,
        items=items
    )


if __name__ == "__main__":
    init_db()
    app.run(debug=True)