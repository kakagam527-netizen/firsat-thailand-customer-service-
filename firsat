@app.route("/customers/add", methods=["GET", "POST"])
def add_customer():

    if request.method == "POST":

        conn = get_db()

        last = conn.execute("""
            SELECT code
            FROM customers
            ORDER BY id DESC
            LIMIT 1
        """).fetchone()

        if last:
            number = int(last["code"].replace("CUS", "")) + 1
        else:
            number = 1

        code = f"CUS{number:04d}"

        conn.execute("""
            INSERT INTO customers
            (code, name, phone, address, notes)
            VALUES (?, ?, ?, ?, ?)
        """, (
            code,
            request.form["name"],
            request.form["phone"],
            request.form["address"],
            request.form["notes"]
        ))

        conn.commit()
        conn.close()

        return redirect(url_for("customers_page"))

    return render_template("add_customer.html")


